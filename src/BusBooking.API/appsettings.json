    "Secret": "",
    "Issuer": "BusBooking",
    "Audience": "BusBooking.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Seed": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "BusBooking:"
  },
  "CancellationPolicy": {
    "MinimumHoursBeforeDeparture": 2
  },
  "Email": {
    "FromAddress": "noreply@busbooking.lk",
    "FromName": "BusBooking",
