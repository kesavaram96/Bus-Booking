    "Port": 587,
    "Username": "",
    "Password": "",
    "UseSsl": true,
    "PickupDirectory": ""
  },
  "Hangfire": {
    "UseMemoryStorage": false
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
