<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BusBooking.Infrastructure</RootNamespace>
    <AssemblyName>BusBooking.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Grants access to Microsoft.AspNetCore.Identity, Microsoft.AspNetCore.Authentication.JwtBearer,
         etc. from this plain class library: those ship in the ASP.NET Core shared framework, not as
         standalone NuGet packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Microsoft.Extensions.Configuration.Abstractions and System.Security.Cryptography.Xml are now
         supplied by the Microsoft.AspNetCore.App FrameworkReference above (already at a patched version),
         so no explicit PackageReference is needed for either. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusBooking.Application\BusBooking.Application.csproj" />
    <ProjectReference Include="..\BusBooking.Domain\BusBooking.Domain.csproj" />
  </ItemGroup>

</Project>
