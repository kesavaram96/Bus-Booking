root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion

# Naming: interfaces start with I
dotnet_naming_rule.interface_should_be_prefixed.severity = suggestion
dotnet_naming_rule.interface_should_be_prefixed.symbols = interface_symbol
dotnet_naming_rule.interface_should_be_prefixed.style = prefix_interface_with_i
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_interface_with_i.required_prefix = I
dotnet_naming_style.prefix_interface_with_i.capitalization = pascal_case

# var preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Nullable
dotnet_diagnostic.CS8618.severity = warning

[*.{json,yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 2

[*.csproj]
indent_size = 2
