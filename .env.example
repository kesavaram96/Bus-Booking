# Copy this file to .env and fill in real values before running docker compose.
# .env is already gitignored — never commit real secrets to it.

# --- SQL Server ---
# Must satisfy SQL Server's own complexity policy (8+ chars, at least 3 of: upper, lower,
# digit, symbol) or the sqlserver container will refuse to start.
DB_SA_PASSWORD=Change_Me_Str0ng!

# --- Redis ---
REDIS_PASSWORD=change-me-too

# --- JWT ---
# A long, random string, e.g.: openssl rand -base64 48
# Never reuse the local dev value from user-secrets/appsettings.Development.json.
JWT_SECRET=

# --- Initial SuperAdmin account (created once, on first startup, by IdentitySeeder) ---
SUPERADMIN_EMAIL=admin@busbooking.lk
SUPERADMIN_PASSWORD=Change_Me_Str0ng!

# --- Email (SMTP) ---
# Leave EMAIL_HOST blank in dev to fall back to local .eml file delivery (see
# docker-compose.yml's api-emails volume) — no SMTP server required. A real value is required
# under docker-compose.prod.yml.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- Payment gateway credentials ---
# Placeholder only: no real Sri Lankan payment provider is integrated yet — Phase 14 built Cash
# (always real, no credentials needed) and a Mock gateway standing in for a future one. Add the
# real variable(s) here, and read them from a new IPaymentGateway implementation
# (BusBooking.Infrastructure/Payments), once one exists.
PAYMENT_GATEWAY_API_KEY=

# --- CORS ---
# The deployed React app's origin. For more than one, add Cors__AllowedOrigins__1,
# Cors__AllowedOrigins__2, ... directly in docker-compose(.prod).yml — .env only covers the
# common single-origin case.
REACT_APP_ORIGIN=http://localhost:5173
